{
  "name": "@cqp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:diff:init": "prisma migrate diff --from-empty --to-schema-datamodel=prisma/schema.prisma --script"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@cqp/core": "workspace:*"
  }
}
