{
  "name": "@cqp/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cqp/core": "workspace:*",
    "@cqp/reporting": "workspace:*",
    "@cqp/enrichment": "workspace:*",
    "@cqp/correlation": "workspace:*",
    "@cqp/scan-engine": "workspace:*",
    "@cqp/unit-test-engine": "workspace:*",
    "@cqp/coverage-engine": "workspace:*",
    "@cqp/filesystem-browser": "workspace:*",
    "@cqp/qa-automation-tests": "workspace:*",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/bcryptjs": "^2.4.6"
  }
}
